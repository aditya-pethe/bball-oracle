# Scratch space for agent-generated tooling/scripts/artifacts made while contributing.
# Not part of the product — don't put anything here the app or pipeline depends on.
.agents/
.env
.venv/
__pycache__/
.pytest_cache/
*.pyc

# Downloaded/extracted nba_data archives -- refetched from list_data.txt on demand,
# never committed.
.cache/
.vercel/
.playwright-mcp/

# Agent-tool worktrees (created/removed by the harness, never committed)
.claude/worktrees/

# Vitest/vite caches land here when a tool is run from the repo root rather than
# from web/. web/.gitignore's `/node_modules` is anchored to web/ and does not
# cover this one.
node_modules/
